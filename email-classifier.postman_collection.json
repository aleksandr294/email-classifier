                  ],
                  "path": [
                    "api",
                    "v1",
                    "classify",
                    "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    ""
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"status\": \"classified\",\n  \"category\": \"newsletter\",\n  \"confidence\": 0.95,\n  \"reasoning\": \"This email is a newsletter subscription with unsubscribe link and curated content.\",\n  \"signals\": [\"unsubscribe link present\", \"sender is newsletter@techdigest.io\", \"structured content\"],\n  \"reviewed\": false\n}"
            },
            {
              "name": "404 — Not Found",
              "originalRequest": {
